# Created by the new-feature skill's worktree workflow, never meant to be committed.
.claude/worktrees/

# Raw weekly snapshot downloads: large, re-fetched by scripts/fetch-snapshot.mjs, not meant to live in git history.
docs/*.xlsx
.cache/

.env
.env.*
!.env.example
